// HoopMind AI — Prisma schema (see .kiro/specs/hoopmind-ai/design.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Position {
  PG
  SG
  SF
  PF
  C
}

enum PlayFormat {
  FIVE_V_FIVE
  THREE_X_THREE
}

enum Handedness {
  LEFT
  RIGHT
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Goal {
  SHOOTING
  BALL_HANDLING
  VERTICAL
  DEFENSE
}

enum Scenario {
  FULL_COURT
  HALF_COURT
  STREET
  GYM_NO_HOOP
}

enum BlockType {
  WARMUP
  TECHNIQUE
  FINISHING
  CONDITIONING
  COOLDOWN
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// Usuario = identidad de Supabase Auth (auth.users.id). No se almacena contraseña aquí.
model User {
  id             String          @id @db.Uuid // = auth.uid()
  email          String          @unique
  createdAt      DateTime        @default(now())
  profile        Profile?
  workouts       Workout[]
  sessions       Session[]
  customPlays    CustomPlay[]
  combineResults CombineResult[]
  gymSessions    GymSession[]
  bodyMeasurements BodyMeasurement[]
}

model Profile {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @unique @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  heightCm   Int // 120–240
  weightKg   Int // 30–200
  position   Position
  format     PlayFormat
  handedness Handedness
  level      SkillLevel
  goals      Goal[] // 1–4
  isComplete Boolean    @default(false)
  // Gamification (v2): XP accrues per completed session; gameLevel recalculated on close.
  xp         Int        @default(0)
  gameLevel  Int        @default(1)
  updatedAt  DateTime   @updatedAt
}

model Workout {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  scenario    Scenario
  format      PlayFormat     @default(FIVE_V_FIVE) // captured from profile at generation
  durationMin Int // 30 | 45 | 60
  difficulty  Int            @default(3) // 1–5, ajustado progresivamente
  content     Json // WorkoutSchema validado (fuente de verdad)
  createdAt   DateTime       @default(now())
  blocks      WorkoutBlock[]
  sessions    Session[]

  @@index([userId, createdAt])
}

// Normalización ligera para consulta/listado; el Json de Workout mantiene el detalle completo.
model WorkoutBlock {
  id          String     @id @default(uuid()) @db.Uuid
  workoutId   String     @db.Uuid
  workout     Workout    @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  type        BlockType
  order       Int
  durationMin Int
  exercises   Exercise[]
}

model Exercise {
  id          String       @id @default(uuid()) @db.Uuid
  blockId     String       @db.Uuid
  block       WorkoutBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  order       Int
  name        String
  description String
  reps        String? // p. ej. "3x10" o "5 min"
  drillId     String? // referencia a drill precargado para la pizarra
  shotLogs    ShotLog[]
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId     String         @db.Uuid
  workout       Workout        @relation(fields: [workoutId], references: [id])
  status        SessionStatus  @default(IN_PROGRESS)
  startedAt     DateTime       @default(now())
  endedAt       DateTime?
  realDurationS Int?
  shotLogs      ShotLog[]
  shotAnalyses  ShotAnalysis[]
  report        SessionReport?

  @@index([userId, startedAt])
}

// Post-session AI report (v2): summary + actionable recommendations + XP earned.
model SessionReport {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @unique @db.Uuid
  session         Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  summary         String
  recommendations Json // string[] of actionable tips
  xpEarned        Int      @default(0)
  createdAt       DateTime @default(now())
}

// Agregado de tiros por ejercicio y zona dentro de una sesión.
model ShotLog {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @db.Uuid
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String?   @db.Uuid
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  zone       String // id de zona (ver Shot chart)
  made       Int       @default(0)
  attempted  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([sessionId, exerciseId, zone])
  @@index([sessionId, zone])
}

// Resultado del analizador de tiro por cámara (métricas, nunca el video).
model ShotAnalysis {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String?  @db.Uuid
  session     Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  elbowAngle  Float // grados
  kneeFlexion Float // grados
  releaseMs   Int // momento de liberación relativo
  confidence  Float // 0–1
  createdAt   DateTime @default(now())
}

// v3: Combine test categories.
enum CombineTest {
  FIFTY_THREES
  HANDLE_FINISH
  CLUTCH_FT
}

// v3: user-authored plays saved to the personal playbook.
model CustomPlay {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  format    PlayFormat
  category  String
  steps     Json // DrillStep[] in normalized coords
  keyCues   String[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId])
}

// v3: results of the official Combine tests.
model CombineResult {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @db.Uuid
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  testType  CombineTest
  score     Int
  maxScore  Int
  durationS Int
  ovrDelta  Int
  createdAt DateTime    @default(now())

  @@index([userId])
}

// ============================================================
// Body Transformation (Gym) — v4
// ============================================================

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  CORE
  QUADS
  HAMSTRINGS
  GLUTES
  CALVES
}

enum JointImpact {
  LOW
  MEDIUM
  HIGH
}

enum ExerciseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

// Curated, shared exercise catalog (not user-owned). Slug is a stable key.
model GymExercise {
  id              String        @id @default(uuid()) @db.Uuid
  slug            String        @unique
  name            String
  primaryMuscles  MuscleGroup[]
  secondaryMuscles MuscleGroup[]
  level           ExerciseLevel
  jointImpact     JointImpact
  equipment       String
  execution       String // step-by-step technique
  commonMistakes  String[]
  variations      String[]
  defaultSets     Int           @default(3)
  defaultRepsLow  Int           @default(8)
  defaultRepsHigh Int           @default(12)
  restSeconds     Int           @default(90)
  createdAt       DateTime      @default(now())
  setLogs         GymSetLog[]
}

model GymSession {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  focus       MuscleGroup[] // muscle groups targeted this session
  startedAt   DateTime     @default(now())
  endedAt     DateTime?
  notes       String?
  setLogs     GymSetLog[]

  @@index([userId, startedAt])
}

model GymSetLog {
  id          String      @id @default(uuid()) @db.Uuid
  sessionId   String      @db.Uuid
  session     GymSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String      @db.Uuid
  exercise    GymExercise @relation(fields: [exerciseId], references: [id])
  setNumber   Int
  weightKg    Float
  reps        Int
  rpe         Int? // 1–10 perceived exertion (optional)
  isPr        Boolean     @default(false)
  createdAt   DateTime    @default(now())

  @@index([sessionId])
  @@index([exerciseId])
}

model BodyMeasurement {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  measuredAt  DateTime @default(now())
  weightKg    Float?
  bodyFatPct  Float?
  chestCm     Float?
  waistCm     Float?
  hipsCm      Float?
  armCm       Float?
  thighCm     Float?
  notes       String?

  @@index([userId, measuredAt])
}
